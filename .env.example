# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в git не попадает (см. .gitignore).

# Mail.ru-почта, от имени которой отправляются письма с заявками
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=your-account@mail.ru
# Пароль для внешних приложений Mail.ru (Настройки -> Пароль для внешних приложений), не обычный пароль от почты
SMTP_PASSWORD=

# Куда пересылать заявки
LEAD_EMAIL_TO=mihail.mihalkov13@gmail.com

# Порт, на котором слушает бэкенд
PORT=5000
